{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081",
        "android": "2.2081",
        "ios": "2.2081"
    },
    "id": "bogdoner.click-indicators",
    "name": "Click Indicators (4K Mania)",
    "version": "v7.6.0",
    "developers": [
        "Bogdoner"
    ],
    "description": "4-Key osu!mania upscroll circle skin rhythm lane and level click indicators for Geometry Dash macros.",
    "requires-patching": false,
    "settings": {
        "enabled": {
            "name": "Master enable",
            "type": "bool",
            "default": true
        },
        "mania-keys": {
            "name": "Mania key count (Columns)",
            "type": "int",
            "default": 4,
            "min": 1,
            "max": 4
        },
        "note-shape": {
            "name": "Note shape",
            "type": "string",
            "default": "Circle",
            "one-of": [
                "Circle",
                "Slab"
            ]
        },
        "lane-flip": {
            "name": "Upscroll lane",
            "type": "bool",
            "default": true
        },
        "lane": {
            "name": "Show rhythm lane",
            "type": "bool",
            "default": true
        },
        "world-bars": {
            "name": "Show in-level vertical bars",
            "type": "bool",
            "default": true
        },
        "accuracy": {
            "name": "Score my clicks",
            "type": "bool",
            "default": true
        }
    },
    "resources": {
        "files": [
            "resources/hitcircle2x.png",
            "resources/taikohitcircle.png",
            "resources/taikohitcircleoverlay.png",
            "resources/sliderfollowcircle.png"
        ]
    }
}
